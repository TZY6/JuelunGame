    m_PersistentCalls:
      m_Calls: []
  m_text: "\u64CD\u4F5C\u6307\u5357\r\r\n\u6B22\u8FCE\u6765\u5230\u827E\u5C14\u767B\u5927\u9646\u3002\u5728\u4F60\u8E0F\u5165\u8FD9\u7247\u88AB\u9057\u5FD8\u7684\u571F\u5730\u4E4B\u524D\uFF0C\u8BF7\u5148\u719F\u6089\u4EE5\u4E0B\u751F\u5B58\u6307\u4EE4\uFF1A\r\r\n\u63A2\u7D22\u4E0E\u79FB\u52A8\uFF1A\u4F7F\u7528\u952E\u76D8\u4E0A\u7684W/A/S/D\u63A7\u5236\u89D2\u8272\u5728\u8FD9\u7247\u5927\u9646\u4E0A\u81EA\u7531\u7A7F\u884C\u3002\u4F60\u53EF\u4EE5\u8D70\u8FDB\u8FF7\u96FE\u68EE\u6797\u7684\u9634\u5F71\uFF0C\u4E5F\u53EF\u4EE5\u7AD9\u5728\u7E41\u661F\u6E2F\u7684\u7801\u5934\u671B\u5411\u90A3\u5EA7\u6C38\u4E0D\u4EAE\u8D77\u7684\u706F\u5854--\u51E1\u76EE\u5149\u6240\u53CA\u4E4B\u5904\uFF0C\u7686\u53EF\u62B5\u8FBE\u3002\r\r\n\u6218\u6597\u4E0E\u9B54\u6CD5\uFF1A\u9762\u5BF9\u654C\u4EBA\u65F6\uFF0C\u6309\u4E0B\"J\"\u952E\u53D1\u52A8\u653B\u51FB\u3002\u82E5\u4F60\u638C\u63E1\u4E86\u5143\u7D20\u4E4B\u529B\uFF0C\u201CU\u201D\uFF08\u51B0\u96EA\uFF09\u3001\u201CL\u201D\uFF08\u706B\u7130\uFF09\u3001\"O\"\uFF08\u96F7\u7535\uFF09\u5C06\u4E3A\u4F60\u91CA\u653E\u4E09\u79CD\u4E0D\u540C\u7684\u9B54\u6CD5\u3002\u6CE8\u610F\uFF0C\u9B54\u6CD5\u9700\u8981\u51B7\u5374\u65F6\u95F4\uFF0C\u8BF7\u5728\u6218\u6597\u4E2D\u8C28\u614E\u89C4\u5212\u3002\r\r\n\u4EA4\u4E92\u4E0E\u5BF9\u8BDD\uFF1A\u5F53\u5C4F\u5E55\u51FA\u73B0\u4EA4\u4E92\u63D0\u793A\u65F6\uFF0C\u6309\u4E0B\"F\"\u952E\u5373\u53EF\u4E0ENPC\u4EA4\u8C08\u3001\u9886\u53D6\u4EFB\u52A1\u6216\u63D0\u4EA4\u4EFB\u52A1\u3002\u6BCF\u4E2ANPC\u90FD\u6709\u81EA\u5DF1\u7684\u6545\u4E8B\uFF0C\u4E0D\u59A8\u591A\u542C\u542C\u4ED6\u4EEC\u8BF4\u4EC0\u4E48\u3002\r\n\u88C5\u5907\u4E0E\u72B6\u6001\uFF1A\u6309\u201CQ\u201D\u952E\u5FEB\u901F\u5207\u6362\u5DF2\u88C5\u5907\u7684\u6B66\u5668\uFF0C\u6309\u201C1\u201D\u952E\u53EF\u4EE5\u6253\u5F00\u73A9\u5BB6\u624B\u518C\u3002\u4F60\u7684\u6BCF\u4E00\u6B21\u6210\u957F--\u7B49\u7EA7\u3001\u5C5E\u6027\u3001\u5DF2\u4E60\u5F97\u7684\u6280\u80FD\u3001\u80CC\u5305\u4E2D\u7684\u5E93\u5B58\u3001\u4EFB\u52A1\u5B8C\u6210\u60C5\u51B5--\u90FD\u53EF\u4EE5\u5728\u8FD9\u91CC\u6E05\u6670\u67E5\u9605\u3002\r\r\n\u5173\u4E8E\u5F53\u524D\u7248\u672C\uFF1A\u76EE\u524D\u4F60\u6240\u80FD\u4F53\u9A8C\u5230\u7684\uFF0C\u662F\u827E\u5C14\u767B\u5927\u9646\u7684\u6838\u5FC3\u9AA8\u67B6--\u5730\u56FE\u63A2\u7D22\u3001\u6218\u6597\u7CFB\u7EDF\u3001NPC\u4EA4\u4E92\u4E0E\u4EFB\u52A1\u63A5\u53D6\u63D0\u4EA4\u5747\u5DF2\u5B8C\u6574\u96C6\u6210\u3002\u4E16\u754C\u89C2\u4E0E\u4EFB\u52A1\u7EBF\u7684\u8840\u8089\u4ECD\u5728\u96D5\u7422\u4E2D\uFF0C\u90E8\u5206\u5BF9\u8BDD\u4E0E\u5267\u60C5\u5C1A\u4E3A\u5360\u4F4D\u72B6\u6001\u3002\u4F60\u6240\u8E0F\u8DB3\u7684\u8FD9\u7247\u571F\u5730\uFF0C\u6B63\u5728\u9010\u6E10\u201C\u6D3B\u8FC7\u6765\u201D\u3002\r\n\r\n\u613F\u4F60\u5728\u827E\u5C14\u767B\u5927\u9646\u7684\u7B2C\u4E00\u6B65\uFF0C\u8D70\u5F97\u8DB3\u591F\u8FDC\u3002"
