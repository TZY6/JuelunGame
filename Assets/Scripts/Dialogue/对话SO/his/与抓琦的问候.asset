  m_Script: {fileID: 11500000, guid: a328454cea7eaae4399250a8527a90f0, type: 3}
  m_Name: "\u4E0E\u6293\u7426\u7684\u95EE\u5019"
  m_EditorClassIdentifier: 
  Lines:
  - Speaker: {fileID: 11400000, guid: 7c96aae560b17e5428135f9c8870b9da, type: 2}
    Text: "24mfa\u8D75\u4F73\u7426\uFF5E"
  - Speaker: {fileID: 11400000, guid: 481d017e97459ab49ad3fb850f1ddc48, type: 2}
    Text: "\u6536\u5230"
  - Speaker: {fileID: 11400000, guid: 481d017e97459ab49ad3fb850f1ddc48, type: 2}
    Text: "\u6211\u4E5F24"
  - Speaker: {fileID: 11400000, guid: 7c96aae560b17e5428135f9c8870b9da, type: 2}
    Text: "\u8001\u5E08\u4F60\u597D\u5B98\u65B9"
  - Speaker: {fileID: 11400000, guid: 7c96aae560b17e5428135f9c8870b9da, type: 2}
    Text: "\u54C8\u54C8\u54C8\u54C8\u54C8"
  - Speaker: {fileID: 11400000, guid: 481d017e97459ab49ad3fb850f1ddc48, type: 2}
    Text: "\u725B\u9A6C\u5F53\u60EF\u4E86"
  - Speaker: {fileID: 11400000, guid: 481d017e97459ab49ad3fb850f1ddc48, type: 2}
    Text: "2\u53F7\u5385\u4F60\u770B\u4E86\u5417"
  - Speaker: {fileID: 11400000, guid: 7c96aae560b17e5428135f9c8870b9da, type: 2}
    Text: "\u8FD8\u6CA1\uFF08\u54ED\uFF09"
  - Speaker: {fileID: 11400000, guid: 7c96aae560b17e5428135f9c8870b9da, type: 2}
    Text: "\u672C\u6765\u60F3\u95EE"
  - Speaker: {fileID: 11400000, guid: 7c96aae560b17e5428135f9c8870b9da, type: 2}
    Text: "\u4F60\u53BB\u4E0D\u53BB\u5403\u9EA6\u6C47\uFF08\u7B11\uFF09"
  - Speaker: {fileID: 11400000, guid: 7c96aae560b17e5428135f9c8870b9da, type: 2}
    Text: "\u4E00\u8F6C\u773C\u6CA1\u770B\u89C1\u4EBA"
  - Speaker: {fileID: 11400000, guid: 481d017e97459ab49ad3fb850f1ddc48, type: 2}
    Text: "\u4E00\u4E0B\u73ED\u6211\u5C31\u6E9C\u4E86\u54C8\u54C8"
  - Speaker: {fileID: 11400000, guid: 481d017e97459ab49ad3fb850f1ddc48, type: 2}
    Text: "\u665A\u4E0A\u8981\u53BB\u770B\u8131\u53E3\u79C0"
  - Speaker: {fileID: 11400000, guid: 7c96aae560b17e5428135f9c8870b9da, type: 2}
    Text: "oh!\u597D\u7684"
  - Speaker: {fileID: 11400000, guid: 481d017e97459ab49ad3fb850f1ddc48, type: 2}
    Text: "\u660E\u5929\u665A\u4E0A\u53EF\u4EE5\u53BB\u5403"
  - Speaker: {fileID: 11400000, guid: 481d017e97459ab49ad3fb850f1ddc48, type: 2}
    Text: "\u4F46\u662F\u4F60\u662F\u4E0D\u662F\u4E0D\u6765\u4E86"
  - Speaker: {fileID: 11400000, guid: 7c96aae560b17e5428135f9c8870b9da, type: 2}
    Text: "\u597D\u4E5F\uFF0C\u4F46\u662F\u6211\u660E\u5929\u665A\u4E0A\u8981\u53BB\u5B9D\u5C71\u6253\u8FA9\u8BBA"
  - Speaker: {fileID: 11400000, guid: 481d017e97459ab49ad3fb850f1ddc48, type: 2}
    Text: wow
  - Speaker: {fileID: 11400000, guid: 7c96aae560b17e5428135f9c8870b9da, type: 2}
    Text: "\u8981\u662F\u6709\u76F4\u64AD"
  - Speaker: {fileID: 11400000, guid: 7c96aae560b17e5428135f9c8870b9da, type: 2}
    Text: "\u53D1\u7ED9\u4F60\u4EEC"
  - Speaker: {fileID: 11400000, guid: 481d017e97459ab49ad3fb850f1ddc48, type: 2}
    Text: "\u6CA1\u95EE\u9898"
  - Speaker: {fileID: 11400000, guid: 481d017e97459ab49ad3fb850f1ddc48, type: 2}
    Text: "\u7ED9\u4F60\u58F0\u63F4\u4E00\u6CE2"
  - Speaker: {fileID: 11400000, guid: 7c96aae560b17e5428135f9c8870b9da, type: 2}
    Text: "\u54C8\u54C8\u54C8\u54C8"
  - Speaker: {fileID: 11400000, guid: 7c96aae560b17e5428135f9c8870b9da, type: 2}
    Text: "\u540E\u5929\u665A\u4E0A\u8981\u662F\u6CA1\u4E8B"
  - Speaker: {fileID: 11400000, guid: 7c96aae560b17e5428135f9c8870b9da, type: 2}
    Text: "\u4E00\u8D77\u53BB\u5403"
  - Speaker: {fileID: 11400000, guid: 7c96aae560b17e5428135f9c8870b9da, type: 2}
    Text: "\u9EA6\u6C47"
  - Speaker: {fileID: 11400000, guid: 481d017e97459ab49ad3fb850f1ddc48, type: 2}
    Text: "\u54C8\u54C8\u54C8"
  - Speaker: {fileID: 11400000, guid: 481d017e97459ab49ad3fb850f1ddc48, type: 2}
    Text: "\u5BF9\u4E0D\u8D77"
  - Speaker: {fileID: 11400000, guid: 481d017e97459ab49ad3fb850f1ddc48, type: 2}
    Text: "\u5468\u65E5\u665A\u4E0A\u8981\u8DDF\u8868\u59D0\u5403\u996D"
  - Speaker: {fileID: 11400000, guid: 7c96aae560b17e5428135f9c8870b9da, type: 2}
    Text: "\u597D\u7684\u597D\u7684"
  - Speaker: {fileID: 11400000, guid: 481d017e97459ab49ad3fb850f1ddc48, type: 2}
    Text: "\u5468\u4E00\u5462"
  - Speaker: {fileID: 11400000, guid: 7c96aae560b17e5428135f9c8870b9da, type: 2}
    Text: "\u53EF\u4EE5\uFF08\u7B11\uFF09"
  - Speaker: {fileID: 11400000, guid: 481d017e97459ab49ad3fb850f1ddc48, type: 2}
    Text: "\u8FD9\u4E2A\u5468\u672B\u6BD4\u8F83\u6EE1"
  - Speaker: {fileID: 11400000, guid: 7c96aae560b17e5428135f9c8870b9da, type: 2}
    Text: "\u54C8\u54C8\u54C8\u54C8\u54C8\u5FD9\u70B9\u597D\u5440"
  - Speaker: {fileID: 11400000, guid: 481d017e97459ab49ad3fb850f1ddc48, type: 2}
    Text: "ok\u90A3\u5C31\u5468\u4E00"
  - Speaker: {fileID: 11400000, guid: 481d017e97459ab49ad3fb850f1ddc48, type: 2}
    Text: "\u770B\u770B\u4F20\u8BF4\u4E2D\u7684\u9EA6\u6C47"
  - Speaker: {fileID: 11400000, guid: 7c96aae560b17e5428135f9c8870b9da, type: 2}
    Text: "\u771F\u7684\u597D\u5403"
  - Speaker: {fileID: 11400000, guid: 481d017e97459ab49ad3fb850f1ddc48, type: 2}
    Text: "\u6211\u5176\u5B9E\u86EE\u559C\u6B22\u5403\u7684"
  - Speaker: {fileID: 11400000, guid: 481d017e97459ab49ad3fb850f1ddc48, type: 2}
    Text: "\u6CA1\u5565\u522B\u7684\u8FFD\u6C42"
  - Speaker: {fileID: 11400000, guid: 481d017e97459ab49ad3fb850f1ddc48, type: 2}
    Text: "\u8BA9\u6211\u6765\u54C1\u9274\u4E00\u756A"
  - Speaker: {fileID: 11400000, guid: 7c96aae560b17e5428135f9c8870b9da, type: 2}
    Text: "\u6211\u4E5F\uFF0C\u6211\u4E3A\u6570\u4E0D\u591A\u4F53\u9A8C\u5230\u5E78\u798F\u611F\u7684\u4E8B"
  - Speaker: {fileID: 11400000, guid: 7c96aae560b17e5428135f9c8870b9da, type: 2}
    Text: "\u5F00\u5FC3\u4E86\u5403\u4E00\u987F"
  - Speaker: {fileID: 11400000, guid: 7c96aae560b17e5428135f9c8870b9da, type: 2}
    Text: "\u4E0D\u5F00\u5FC3\u5403\u4E00\u987F"
  - Speaker: {fileID: 11400000, guid: 481d017e97459ab49ad3fb850f1ddc48, type: 2}
    Text: "\u6293\u7426\u5973\u58EB\uFF0C\u90A3\u6211\u4EEC\u7684\u6545\u4E8B\uFF0C\u5C31\u4ECE\u8FD9\u91CC\u5F00\u59CB\u5427\u3002"
  - Speaker: {fileID: 11400000, guid: 7c96aae560b17e5428135f9c8870b9da, type: 2}
    Text: "\u563F\u563F\uFF0C\u4E032\u4E2B\u5148\u751F\uFF0C\u6211\u4EEC\u7684\u6545\u4E8B\u5F00\u59CB\u4E86\u54E6\uFF01"
