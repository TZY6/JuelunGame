  Lines:
  - Speaker: {fileID: 11400000, guid: 64951768884c45041b6a83472cbaf582, type: 2}
    Text: "\u603B\u4E4B\uFF0C\u8FD9\u662F\u4E00\u4E2A\u6218\u6597\u4E0E\u9B54\u6CD5\u7684\u4E16\u754C\uFF0C\u4F60\u53EF\u4EE5\u901A\u8FC7\u91CA\u653E\u4E0D\u540C\u7684\u6280\u80FD\u7EC4\u5408\u6765\u51FB\u8D25\u90A3\u4E9B\u89C6\u56FE\u963B\u6B62\u4F60\u7684\u654C\u4EBA\u3002\u6309b\u952E\u53EF\u4EE5\u68C0\u89C6\u80CC\u5305\uFF0C\u5728\u53F3\u4FA7\u7684\u6280\u80FD\u6811\u4E2D\u8FD8\u53EF\u4EE5\u5B66\u4E60\u5347\u7EA7\u5C5E\u6027\u548C\u9B54\u6CD5\u3002"
    OfferQuest: {fileID: 0}
    CompleteQuest: {fileID: 0}
  - Speaker: {fileID: 11400000, guid: c7366a6abce0ad144a548e9882ef2383, type: 2}
    Text: "\u597D\u7684\uFF0C\u8C22\u8C22\u4F60\u7684\u63D0\u9192"
    OfferQuest: {fileID: 0}
    CompleteQuest: {fileID: 0}
  - Speaker: {fileID: 11400000, guid: 64951768884c45041b6a83472cbaf582, type: 2}
    Text: "\u73B0\u5728\uFF0C\u6211\u5DF2\u7ECF\u5411\u4F60\u7684\u4EFB\u52A1\u754C\u9762\u6D3E\u53D1\u4E86\u4E00\u4E2A\u65B0\u624B\u4EFB\u52A1\uFF0C\u5F00\u59CB\u4F53\u9A8C\u6E38\u620F\u5427\uFF01"
    OfferQuest: {fileID: 11400000, guid: d4ed04d8346afaa44b7889ac2fc2f911, type: 2}
    CompleteQuest: {fileID: 0}
  - Speaker: {fileID: 11400000, guid: c7366a6abce0ad144a548e9882ef2383, type: 2}
    Text: "\u975E\u5E38\u6FC0\u52A8\uFF01"
