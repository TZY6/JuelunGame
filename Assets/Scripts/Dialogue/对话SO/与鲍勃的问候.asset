  m_Script: {fileID: 11500000, guid: a328454cea7eaae4399250a8527a90f0, type: 3}
  m_Name: "\u4E0E\u9C8D\u52C3\u7684\u95EE\u5019"
  m_EditorClassIdentifier: 
  Lines:
  - Speaker: {fileID: 11400000, guid: 64951768884c45041b6a83472cbaf582, type: 2}
    Text: "\u4F60\u597D\uFF0C#\u73A9\u5BB6\u540D#\uFF0C\u6B22\u8FCE\u6765\u5230\u8FD9\u4E2A\u6E38\u620F\u3002"
  - Speaker: {fileID: 11400000, guid: 64951768884c45041b6a83472cbaf582, type: 2}
    Text: "\u5230\u76EE\u524D\u4E3A\u6B62\uFF0C\u4F60\u7684\u4F53\u9A8C\u600E\u4E48\u6837\uFF1F\u6709\u5174\u8DA3\u5F00\u5C55\u4E0B\u4E00\u6B65\u4F53\u9A8C\u4E86\u5417\uFF1F"
  - Speaker: {fileID: 11400000, guid: c7366a6abce0ad144a548e9882ef2383, type: 2}
    Text: "\u5F53\u7136\uFF0C\u8BA9\u6211\u4EEC\u5FEB\u5F00\u59CB\u5427\uFF01"
  - Speaker: {fileID: 11400000, guid: 64951768884c45041b6a83472cbaf582, type: 2}
    Text: "\u867D\u7136\u8FD9\u76EE\u524D\u4ECD\u7136\u53EA\u662F\u4E00\u4E2Ademo\uFF0C\u4F46\u5E0C\u671B\u4F60\u73A9\u7684\u5F00\u5FC3\uFF0C\u5E76\u4ECE\u4E2D\u6536\u83B7\u4E00\u4E9B\u4E50\u8DA3\u3002"
  - Speaker: {fileID: 11400000, guid: c7366a6abce0ad144a548e9882ef2383, type: 2}
    Text: "\u8C22\u8C22\u4F60\uFF0C\u9C8D\u52C3\u3002"
  options:
  - optionText: "\u544A\u8BC9\u6211\u66F4\u591A"
    nextDialogue: {fileID: 11400000, guid: a660183642b2ca244a01614c879f22ea, type: 2}
  - optionText: "\u4E0D\u611F\u5174\u8DA3"
    nextDialogue: {fileID: 0}
